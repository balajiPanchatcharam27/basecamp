{
  "name": "basecamp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist/basecamp/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB",
			"database_name": "basecamp-db",
			"database_id": "84aa575c-3218-4311-a91a-0e511505f462" }
  ],
  "triggers": { "crons": ["0 21 * * *"] }
}